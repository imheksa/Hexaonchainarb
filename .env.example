# ─── Hexa Arb Bots (Hexaonchainarb) — Environment Variables ─────────────────
# Copy to .env and fill in your values. Never commit .env to git.

# ── Pelagos Node ──────────────────────────────────────────────────────────────
# Your Pelagos validator ID (assigned when you register as a validator)
PELAGOS_VALIDATOR_ID=

# ── BNB Chain RPC (for local testing only; Pelagos validators use their own nodes) ──
BNB_RPC_URL=https://bsc-dataseed.binance.org/

# ── Smart Contract ────────────────────────────────────────────────────────────
# Address of the deployed ArbitrageExecutor.sol on BNB Chain
ARBITRAGE_EXECUTOR_ADDRESS=

# Deployer private key (only for deploy script, never used at runtime)
DEPLOYER_PRIVATE_KEY=

# ── Arbitrage Settings (override genesis defaults at runtime) ─────────────────
# Minimum profit in basis points (1 BPS = 0.01%)
MIN_PROFIT_BPS=10

# Maximum USDT to borrow per flash loan (in USDT with 18 decimals)
# Default: 10,000 USDT = 10000000000000000000000
MAX_BORROW_WEI=10000000000000000000000
