# ─── Hexa Arb Bots (Hexaonchainarb) — Environment Variables ─────────────────
# Copy: cp .env.example .env  lalu isi nilainya. Jangan commit .env ke git.

# ── Pelagos pelacli.yaml — Write Chain ────────────────────────────────────────
# Private key deployer TANPA prefix 0x (untuk kirim ExternalTransaction ke BNB)
DEPLOYER_PRIVATE_KEY=

# Pelagos contract address di BNB Chain Testnet (dari Pelagos team)
PELAGOS_CONTRACT_BSC_TESTNET=

# ── Smart Contract ────────────────────────────────────────────────────────────
# Address ArbitrageExecutor.sol yang sudah di-deploy di BNB Testnet
ARBITRAGE_EXECUTOR_ADDRESS=0x45ae4eD418C5C1E77bb1e8005C86426238De8474

# ── Arbitrage Settings ────────────────────────────────────────────────────────
# Minimum profit dalam basis points (1 BPS = 0.01%). Default: 10 = 0.1%
MIN_PROFIT_BPS=10

# Maximum flash loan USDT per eksekusi (dalam wei, 18 desimal)
# Default: 10,000 USDT
MAX_BORROW_WEI=10000000000000000000000
